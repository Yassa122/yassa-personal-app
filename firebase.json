{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/collect", "function": "collectVisit" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "runtime": "nodejs18"
  }
}
